{
  "harness": "ai-harness-framework",
  "version": "0.4.0",
  "schemaVersions": {
    "featureList": 1,
    "archRules": 1,
    "trace": 1,
    "manifest": 3
  },
  "core": [
    "AGENTS.md",
    "CLAUDE.md",
    "codex.md",
    "GEMINI.md",
    "Makefile",
    "package.json",
    "init.sh",
    "scripts/",
    "tests/",
    "skills/",
    "templates/",
    "LICENSE",
    ".nvmrc",
    ".harness/manifest.json",
    ".harness/arch-rules.json"
  ],
  "templates": [
    { "from": "templates/README.md", "to": "README.md" },
    { "from": "templates/gitignore", "to": ".gitignore" },
    { "from": "templates/progress.md", "to": "PROGRESS.md" },
    { "from": "templates/DECISIONS.md", "to": "DECISIONS.md" },
    { "from": "templates/feature-list.json", "to": "feature_list.json" },
    { "from": "templates/session-handoff.md", "to": "session-handoff.md" },
    { "from": "templates/quality-document.md", "to": "docs/quality-document.md" },
    { "from": "templates/docs/PRODUCT.md", "to": "docs/PRODUCT.md" },
    { "from": "templates/docs/ARCHITECTURE.md", "to": "docs/ARCHITECTURE.md" },
    { "from": "templates/docs/OBSERVABILITY.md", "to": "docs/OBSERVABILITY.md" },
    { "from": "templates/docs/TOOLS.md", "to": "docs/TOOLS.md" },
    { "from": "templates/docs/USAGE.md", "to": "docs/USAGE.md" },
    { "from": "templates/docs/STANDARDS.md", "to": "docs/STANDARDS.md" },
    { "from": "templates/docs/decisions/index.md", "to": "docs/decisions/index.md" },
    { "from": "templates/multi-repo/verify-all", "to": "scripts/verify-all" },
    { "from": "templates/multi-repo/contracts/README.md", "to": "contracts/README.md" },
    { "from": "templates/multi-repo/tasks/README.md", "to": "tasks/README.md" },
    { "from": "templates/multi-repo/repositories/README.md", "to": "repositories/README.md" },
    { "from": "templates/multi-repo/repositories/example/scripts/verify", "to": "repositories/example/scripts/verify" },
    { "from": "templates/sprint-contract.md", "keep": true },
    { "from": "templates/evaluator-rubric.md", "keep": true },
    { "from": "templates/clean-state-checklist.md", "keep": true }
  ],
  "instance": [
    "feature_list.json",
    "PROGRESS.md",
    "claude-progress.md",
    "DECISIONS.md",
    "session-handoff.md",
    "README.md",
    ".gitignore",
    "package-lock.json",
    ".claude/settings.json",
    "docs/PRODUCT.md",
    "docs/ARCHITECTURE.md",
    "docs/OBSERVABILITY.md",
    "docs/TOOLS.md",
    "docs/USAGE.md",
    "docs/STANDARDS.md",
    "docs/quality-document.md",
    "docs/decisions/",
    ".harness/trails/",
    ".harness/traces/.gitkeep"
  ],
  "productRoots": [],
  "optionalComponents": [
    {
      "name": "multi-repo",
      "description": "Root control plane + subrepo execution domains: contracts/, tasks/, repositories/*/scripts/verify, scripts/verify-all. Adopters activate it by copying the templates/multi-repo skeletons to their declared destinations (see the manifest templates entries); single-repo projects pass check without it, and verify-all reports SKIP when the markers are absent.",
      "markers": ["contracts/", "tasks/", "repositories/", "scripts/verify-all"]
    }
  ],
  "customizationPoints": {
    "mustEdit": [
      "feature_list.json (feature content)",
      "docs/ (project-specific guidance)",
      ".harness/arch-rules.json (project rules)"
    ],
    "mayEdit": [
      "Makefile (extra targets only)",
      "package.json (project scripts)",
      "init.sh (stack-specific verification)",
      ".harness/manifest.json (productRoots only)",
      "skills/ (add project skills only — never modify the shipped skills)"
    ],
    "mustNotEdit": [
      "scripts/framework-check.mjs",
      "the manifest classification (core, instance, templates, optionalComponents)",
      "the PASS/SKIP/FAIL semantics of verification layers",
      "the feature state machine and WIP=1 contract"
    ]
  }
}
