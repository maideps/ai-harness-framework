{
  "harness": "ai-harness-framework",
  "version": "0.3.0",
  "schemaVersions": {
    "featureList": 1,
    "archRules": 1,
    "trace": 1,
    "manifest": 2
  },
  "core": [
    "AGENTS.md",
    "CLAUDE.md",
    "Makefile",
    "package.json",
    "init.sh",
    "scripts/",
    "templates/",
    "LICENSE",
    ".nvmrc",
    ".harness/manifest.json",
    ".harness/arch-rules.json"
  ],
  "templates": [
    "templates/README.md",
    "templates/gitignore",
    "templates/progress.md",
    "templates/DECISIONS.md",
    "templates/feature-list.json",
    "templates/session-handoff.md",
    "templates/quality-document.md",
    "templates/sprint-contract.md",
    "templates/evaluator-rubric.md",
    "templates/clean-state-checklist.md",
    "templates/docs/PRODUCT.md",
    "templates/docs/ARCHITECTURE.md",
    "templates/docs/OBSERVABILITY.md",
    "templates/docs/TOOLS.md",
    "templates/docs/USAGE.md",
    "templates/docs/decisions/index.md"
  ],
  "instance": [
    "feature_list.json",
    "PROGRESS.md",
    "claude-progress.md",
    "DECISIONS.md",
    "session-handoff.md",
    "README.md",
    ".gitignore",
    "package-lock.json",
    ".claude/settings.json",
    "docs/PRODUCT.md",
    "docs/ARCHITECTURE.md",
    "docs/OBSERVABILITY.md",
    "docs/TOOLS.md",
    "docs/USAGE.md",
    "docs/quality-document.md",
    "docs/decisions/",
    ".harness/trails/",
    ".harness/traces/.gitkeep"
  ],
  "productRoots": [],
  "optionalComponents": [
    {
      "name": "multi-repo",
      "description": "Root control plane + subrepo execution domains: contracts/, tasks/, repositories/*/scripts/verify, scripts/verify-all. Adopters activate it only when the project spans multiple repositories.",
      "markers": ["contracts/", "tasks/", "repositories/", "scripts/verify-all"]
    }
  ],
  "customizationPoints": {
    "mustEdit": [
      "feature_list.json (feature content)",
      "docs/ (project-specific guidance)",
      ".harness/arch-rules.json (project rules)"
    ],
    "mayEdit": [
      "Makefile (extra targets only)",
      "package.json (project scripts)",
      "init.sh (stack-specific verification)",
      ".harness/manifest.json (productRoots only)"
    ],
    "mustNotEdit": [
      "scripts/framework-check.mjs",
      "the manifest classification (core, instance, templates, optionalComponents)",
      "the PASS/SKIP/FAIL semantics of verification layers",
      "the feature state machine and WIP=1 contract"
    ]
  }
}
